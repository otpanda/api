{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "otpanda-api",
  "main": "src/cloudflare-worker.js",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "DEPLOYMENT_STAGE": "bootstrap",
    "GOOGLE_CLIENT_ID": "367143149550-560r90pmkqr71qp1tid3amck2a053rdg.apps.googleusercontent.com",
    "BREVO_SENDER_EMAIL": "otpanda.app@gmail.com",
    "BREVO_REPLY_TO_EMAIL": "otpanda.app@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "otpanda",
      "database_id": "626cd908-0951-49cf-92a2-9a54cbbb40a8",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "observability": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "SIGNUP_ADDRESS_LIMIT",
      "namespace_id": "68022001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "SIGNUP_GLOBAL_LIMIT",
      "namespace_id": "68022002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "SIGNUP_VERIFY_ADDRESS_LIMIT",
      "namespace_id": "68022003",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "SIGNUP_VERIFY_GLOBAL_LIMIT",
      "namespace_id": "68022004",
      "simple": {
        "limit": 15,
        "period": 60
      }
    },
    {
      "name": "IDENTITY_ADDRESS_LIMIT",
      "namespace_id": "68022005",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "IDENTITY_AUTH_GLOBAL_LIMIT",
      "namespace_id": "68022006",
      "simple": {
        "limit": 15,
        "period": 60
      }
    },
    {
      "name": "IDENTITY_READ_GLOBAL_LIMIT",
      "namespace_id": "68022007",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
