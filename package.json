{
  "name": "@otpanda/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/worker.js && npm test",
    "build": "npm test && wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler d1 migrations apply otpanda --remote && wrangler deploy",
    "db:local": "wrangler d1 migrations apply otpanda --local"
  },
  "dependencies": {
    "oauth4webapi": "3.8.9"
  },
  "devDependencies": {
    "wrangler": "4.166.0"
  }
}
